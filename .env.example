# puck — local development environment
# =====================================
#
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
#
# `.env` is gitignored. NEVER commit a real `.env` — it would leak keys.
#
# These env vars are read by:
#   - scripts/pty-e2e.cjs          → MINIMAX_API_KEY (for the login wizard)
#   - scripts/pty-selector.cjs     → MINIMAX_API_KEY
#   - scripts/pty-fixregress.cjs   → MINIMAX_API_KEY
#   - bench/runner.mjs             → reads from ~/.puck/auth.json (preferred)
#
# Provider env vars (alternative to ~/.puck/auth.json):
#   See packages/llm/src/auth.ts → PROVIDERS[].apiKeyEnvs
#   (e.g. ANTHROPIC_API_KEY, OPENAI_API_KEY, DEEPSEEK_API_KEY, etc.)
#
# Optional PTY test config:
#   PTY_CWD=/path/to/test/repo   # overrides default os.tmpdir() for pty-e2e

# MiniMax CN API key (used by pty-*.cjs scripts)
MINIMAX_API_KEY=
