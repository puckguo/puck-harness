{
	"name": "@puckguo123/web",
	"version": "0.2.1",
	"description": "puck web client — SSE server exposing the puck harness to a browser UI.",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./server": {
			"types": "./dist/server.d.ts",
			"default": "./dist/server.js"
		},
		"./package.json": "./package.json"
	},
	"bin": {
		"puck-web": "./dist/cli.js"
	},
	"files": [
		"dist",
		"public",
		"README.md"
	],
	"sideEffects": false,
	"keywords": [
		"ai",
		"agent",
		"web",
		"sse",
		"harness"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/puckguo/puck-harness.git",
		"directory": "packages/web"
	},
	"homepage": "https://github.com/puckguo/puck-harness#readme",
	"bugs": {
		"url": "https://github.com/puckguo/puck-harness/issues"
	},
	"author": {
		"name": "puck contributors"
	},
	"publishConfig": {
		"access": "public"
	},
	"engines": {
		"node": ">=22.18.0"
	},
	"dependencies": {
		"@puckguo123/core": "*",
		"@puckguo123/features": "*",
		"@puckguo123/llm": "*",
		"@puckguo123/sdk": "*",
		"@puckguo123/session": "*",
		"@puckguo123/tools": "*"
	}
}
